    # 1. Create a Car base class
class Car:
    def __init__(self, make, model, sticker_price):
        self._make = make
        self._model = model
        self._sticker_price = sticker_price

    # Methods for make, model, sticker price
    def make(self):
        return self._make

    def model(self):
        return self._model

    def sticker_price(self):
        return self._sticker_price

    # Discount price method (90% of sticker price)
    def discount_price(self):
        return self._sticker_price * 0.90

# 2. Create a derived class called Sport
class Sport(Car):
    def __init__(self, make, model, sticker_price):
        super().__init__(make, model, sticker_price)
        # Default options set to 'N'
        self.opt_wheels = 'N'
        self.opt_engine = 'N'
        self.opt_interior = 'N'

    # Define a method for each option
    def sport_wheels(self, choice):
        self.opt_wheels = choice.upper()

    def sport_engine(self, choice):
        self.opt_engine = choice.upper()

    def sport_interior(self, choice):
        self.opt_interior = choice.upper()

    def pricewithoptions(self):
        total_price = self.discount_price()
        if self.opt_wheels == 'Y':
            total_price += 1000.00
        if self.opt_engine == 'Y':
            total_price += 3000.00
        if self.opt_interior == 'Y':
            total_price += 2000.00
        return total_price

# 3. Create a derived class called Luxury
class Luxury(Car):
    def __init__(self, make, model, sticker_price):
        super().__init__(make, model, sticker_price)
        # Default options set to 'N'
        self.opt_gps = 'N'
        self.opt_self_driving = 'N'

    # Overridden option methods for Luxury class
    def gps(self, choice):
        self.opt_gps = choice.upper()

    def self_driving(self, choice):
        self.opt_self_driving = choice.upper()

    def pricewithoptions(self):
        total_price = self.discount_price()
        if self.opt_gps == 'Y':
            total_price += 5000.00
        if self.opt_self_driving == 'Y':
            total_price += 10000.00
        return total_price

# --- Instantiation and Testing ---
if __name__ == "__main__":
    print("--- Testing Sport Class ---")
    my_sport = Sport("Ford", "Mustang", 30000.00)
    print(f"Vehicle: {my_sport.make()} {my_sport.model()}")
    print(f"Base Sticker Price: ${my_sport.sticker_price():,.2f}")
    print(f"Discounted Base Price (90%): ${my_sport.discount_price():,.2f}")
    
    # Setting options
    my_sport.sport_wheels('Y')
    my_sport.sport_engine('Y')
    my_sport.sport_interior('N') 
    
    print(f"Final Price with Selected Options: ${my_sport.pricewithoptions():,.2f}\n")

    print("--- Testing Luxury Class ---")
