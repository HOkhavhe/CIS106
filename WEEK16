# Base class from previous assignment (assumed structure)
class Employee:
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

# 1. Create a Manager class derived from Employee
class Manager(Employee):
    def __init__(self, name, salary):
        super().__init__(name, salary)
        
    def long_term_bonus(self):
        # Computes 40% of their salary
        return self.salary * 0.40

# 2. Create a derived class called Executive
class Executive(Manager):
    def __init__(self, name, salary):
        super().__init__(name, salary)
        
    def executive_bonus(self):
        # 200% of annual salary
        return self.salary * 2.00
        
    def long_term_bonus(self):
        # Override the long term bonus method to be 50%
        return self.salary * 0.50

